# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER use NEXT_PUBLIC_ for secrets or commit an actual .env file.
# Use a pooled Neon connection string with sslmode=require for application requests.
DATABASE_URL=postgresql://USERNAME:PASSWORD@POOLER-HOST/DBNAME?sslmode=require

# Run infra/migrations/0001_auth_workspaces.sql once using the DIRECT Neon connection URL.
# Do not paste production secrets into a chat or commit migrations with credentials.
# EMAIL_PROVIDER_* are required before enabling real email verification, recovery and admin activation.
# No default admin exists, and no workspace owner automatically becomes a platform admin.

# Optional mail delivery (required to enable email verification or password recovery).
# Add these to Vercel encrypted environment settings, NOT to Git.
RESEND_API_KEY=
EMAIL_FROM=
OTP_PEPPER=
